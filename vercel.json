  "functions": {
    "api/inngest.js": {
      "maxDuration": 300,
      "includeFiles": "skills/kira-research-report/templates/*"
    },
    "api/cron-econ-refresh.js": { "maxDuration": 800, "includeFiles": "node_modules/pdf-parse/lib/pdf.js/v1.10.100/build/**" },
    "api/cron-moves.js": { "maxDuration": 800 },
    "api/cron-registry.js": { "maxDuration": 800 },
    "api/cron-geo-econ.js": { "maxDuration": 300 },
    "api/list-buy.js": { "maxDuration": 300 },
    "api/ssr.js": {
      "maxDuration": 30,
      "includeFiles": "public/en/{reports,insights,experts/transcripts}/_view.html"
    },
    "api/home.js": {
      "maxDuration": 10,
      "includeFiles": "public/_home.html"
    },
    "api/listing.js": {
      "maxDuration": 30,
      "includeFiles": "public/**/_list.html"
    },
    "api/econ-page.js": {
      "maxDuration": 30,
      "includeFiles": "public/en/data/_econ.html"
    },
    "api/geo.js": {
      "maxDuration": 30,
      "includeFiles": "public/en/markets/_view.html"
    },
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "skills/kira-research-report/templates/*"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy-Report-Only", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://www.paypal.com https://www.sandbox.paypal.com" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)",
